{
  "tests": [
    {
      "name": "GET all updates",
      "method": "GET",
      "path": "/",
      "expectedStatus": 200,
      "expectedBody": { "updates": [] },
      "bodyMatcher": "partial"
    },
    {
      "name": "POST create update",
      "method": "POST",
      "path": "/",
      "body": {
        "version": "2.0.5",
        "title": "Тест обновления",
        "description": "Проверочное обновление",
        "update_type": "patch",
        "status": "active"
      },
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET pending via query action",
      "method": "GET",
      "path": "/?action=pending&agent_id=test-agent-001",
      "expectedStatus": 200,
      "expectedBody": { "pending": [] },
      "bodyMatcher": "partial"
    },
    {
      "name": "POST create snapshot",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "snapshot",
        "name": "Тест снапшот 20.05.2026",
        "description": "Проверочный снапшот",
        "snapshot_type": "manual",
        "state": { "version": "2.0.5", "test": true }
      },
      "expectedStatus": 200,
      "expectedBody": { "ok": true },
      "bodyMatcher": "partial"
    },
    {
      "name": "GET snapshots list",
      "method": "GET",
      "path": "/?action=snapshots",
      "expectedStatus": 200,
      "expectedBody": { "snapshots": [] },
      "bodyMatcher": "partial"
    }
  ]
}