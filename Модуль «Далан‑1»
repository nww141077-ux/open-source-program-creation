class Dalan1Coordinator:
    def __init__(self):
        self.national_agents: Dict[str, str] = {
            "Russia_North": "http://russia-north.api:8001",
            "Russia_Center": "http://russia-center.api:8002",
            "Russia_South": "http://russia-south.api:8003",
            "USA_East": "http://usa-east.api:8011",
            # ... остальные агенты
        }
        self.priority_matrix = self._build_priority_matrix()

    def _build_priority_matrix(self) -> Dict[str, int]:
        """Матрица приоритетов по типам инцидентов"""
        return {
            "Nuclear": 5, "Earthquake": 4, "Flood": 3,
            "SocialUnrest": 2, "MinorIncident": 1
        }

    async def receive_incident_from_agent(self, incident: Incident) -> Dict:
        """Приём инцидента от национального ИИ"""
        global_incidents[incident.id] = incident

        # Проверка на конфликты
        conflict_check = await self._check_for_conflicts(incident)

        if conflict_check['has_conflict']:
            resolution = await self.resolve_conflict(incident, conflict_check['conflicting_agents'])
            conflict_log.append(resolution)

        # Распределение ресурсов
        allocation_plan = await self._allocate_resources(incident)

        return {
            "status": "processed",
            "incident_id": incident.id,
            "conflict_resolved": conflict_check['has_conflict'],
            "resource_allocation": allocation_plan
        }

    async def _check_for_conflicts(self, incident: Incident) -> Dict:
        """Проверка на конфликты с другими инцидентами"""
        conflicting = []
        for inc_id, inc in global_incidents.items():
            if inc_id != incident.id:
                # Проверка пространственного пересечения
                distance = self._calculate_distance(
                    incident.coordinates, inc.coordinates
                )
                if distance < 50:  # в километрах
                    conflicting.append(inc_id)
        return {"has_conflict": len(conflicting) > 0, "conflicting_agents": conflicting}

    async def resolve_conflict(self, incident: Incident, conflicting_agents: List[str]) -> ConflictResolution:
        """Разрешение конфликта между агентами"""
        # Стратегия: приоритет отдаётся более критичному инциденту
        main_incident = max(
            [global_incidents[cid] for cid in conflicting_agents + [incident.id]],
            key=lambda x: x.priority
        )
        resolution = ConflictResolution(
            incident_id=main_incident.id,
            conflicting_agents=conflicting_agents,
            resolution_strategy="Priority-based resolution"
        )
        return resolution

    async def _allocate_resources(self, incident: Incident) -> Dict:
        """Распределение ресурсов на устранение инцидента"""
        # Логика распределения ресурсов
        return {"assigned_agents": [incident.source_region], "priority": incident.priority}

# Инициализация координатора
dalan1 = Dalan1Coordinator()
