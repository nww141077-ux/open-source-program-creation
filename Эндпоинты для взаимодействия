@app.post("/api/v1/dalan1/incident")
async def dalan1_receive_incident(incident: Incident):
    """Национальный ИИ отправляет инцидент в «Далан‑1»"""
    result = await dalan1.receive_incident_from_agent(incident)
    return result

@app.get("/api/v1/dalan1/dashboard")
async def global_dashboard():
    """Глобальная панель мониторинга"""
    stats = {
        "total_incidents": len(global_incidents),
        "active_conflicts": len([c for c in conflict_log if c.resolution_strategy == "Pending"]),
        "by_region": {},
        "by_category": {}
    }
    # Подсчёт статистики по регионам и категориям
    for incident in global_incidents.values():
        stats["by_region"][incident.source_region] = stats["by_region"].get(incident.source_region, 0) + 1
        stats["by_category"][incident.category] = stats["by_category"].get(incident.category, 0) + 1
    return stats

