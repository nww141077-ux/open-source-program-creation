from fastapi import FastAPI, Depends
from pydantic import BaseModel
from typing import Dict, List, Optional
import uuid
from datetime import datetime

app = FastAPI(title="Dalan-1 Global Incident Management")

# Модели данных
class Incident(BaseModel):
    id: str = str(uuid.uuid4())
    description: str
    source_region: str  # "Russia", "USA", "China", etc.
    category: str
    criticality: float  # 0.0–1.0
    coordinates: List[float]  # [lat, lon]
    priority: int  # 1–5
    timestamp: datetime = datetime.utcnow()
    status: str = "reported"

class ConflictResolution(BaseModel):
    incident_id: str
    conflicting_agents: List[str]
    resolution_strategy: str
    resolved_by: str = "Dalan-1"
    resolution_timestamp: datetime = datetime.utcnow()

# Хранилище данных
global_incidents: Dict[str, Incident] = {}
conflict_log: List[ConflictResolution] = []
